{
  "schemaVersion": 1,
  "id": "trig-intuition-101",
  "kind": "course",
  "extension": ".syntaxcourse",
  "name": "Trigonometry Intuition",
  "tagline": "See sine and cosine as coordinates on a circle, not memorized ratios.",
  "description": "A community starter course demonstrating how a .syntaxcourse depends on a reusable .syntaxembeddedplugin (Unit Circle Lab) that installs automatically in one click.",
  "version": "1.0.0",
  "author": {
    "handle": "community-math",
    "displayName": "Community Math Lab",
    "official": false,
    "verified": true
  },
  "accentColor": "#38bdf8",
  "tags": [
    "Trigonometry",
    "Math",
    "Community",
    "Starter"
  ],
  "touchesCore": false,
  "courseRoute": "custom",
  "requires": [
    {
      "id": "unit-circle-lab",
      "kind": "embedded-plugin",
      "minVersion": "1.0.0",
      "name": "Unit Circle Lab"
    }
  ],
  "customCourse": {
    "subtitle": "Interactive coordinates on the unit circle",
    "units": [
      {
        "title": "Angles as Coordinates",
        "lessons": [
          {
            "id": "trig-l1",
            "title": "Cosine is Horizontal, Sine is Vertical",
            "summary": "Drag the Unit Circle Lab slider above to 0 deg, 90 deg, and 180 deg and watch the blue (x) and green (y) segments.",
            "prompt": "At 90 degrees (straight up on the unit circle), what are cos(90) and sin(90)?",
            "choices": [
              "cos = 0, sin = 1",
              "cos = 1, sin = 0",
              "cos = -1, sin = 0",
              "cos = 0.71, sin = 0.71"
            ],
            "answerIndex": 0,
            "explanation": "At 90 degrees the point sits at (0, 1) on the unit circle, so horizontal cosine is 0 and vertical sine is 1."
          },
          {
            "id": "trig-l2",
            "title": "Why 45 Degrees Makes Equal Legs",
            "summary": "Set the angle slider to 45 degrees. Notice that the right triangle inside the circle is isosceles.",
            "prompt": "At 45 degrees, how do cos(45) and sin(45) compare?",
            "choices": [
              "cos(45) is larger",
              "sin(45) is larger",
              "They are equal (about 0.71)",
              "Both are 0.50"
            ],
            "answerIndex": 2,
            "explanation": "A 45-45-90 triangle has two equal legs, each equal to sqrt(2)/2, which is approximately 0.71."
          }
        ]
      }
    ]
  },
  "safety": {
    "automatedScan": "passed",
    "sandboxed": true,
    "networkAccess": "none",
    "lastChecked": "2026-11-24",
    "official": false
  },
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#0284c7\"/><path d=\"M12 40C18 16 26 16 32 32C38 48 46 48 52 24\" stroke=\"#ffffff\" stroke-width=\"3.8\" stroke-linecap=\"round\"/><circle cx=\"32\" cy=\"32\" r=\"4.5\" fill=\"#fbbf24\"/></svg>",
  "packageUrl": "https://i-am-drunk.github.io/syntax-community/packages/trig-intuition-101.syntaxcourse"
}
