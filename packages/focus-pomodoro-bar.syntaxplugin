{
  "schemaVersion": 1,
  "id": "focus-pomodoro-bar",
  "kind": "plugin",
  "extension": ".syntaxplugin",
  "name": "Focus Timer",
  "tagline": "Sandboxed 25-minute study timer with zero core access.",
  "description": "A clean, calm Pomodoro timer that runs entirely inside an isolated iframe sandbox with zero network access and zero core hooks.",
  "version": "1.0.0",
  "author": {
    "handle": "calm-tools",
    "displayName": "Calm Study Tools",
    "official": false,
    "verified": true
  },
  "accentColor": "#ef4444",
  "tags": [
    "Productivity",
    "Timer",
    "Community"
  ],
  "touchesCore": false,
  "safety": {
    "automatedScan": "passed",
    "sandboxed": true,
    "networkAccess": "none",
    "lastChecked": "2026-11-24",
    "official": false
  },
  "sandboxHtml": "<div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;\">\n  <div>\n    <div style=\"font-size:12px;color:var(--sx-muted);text-transform:uppercase;letter-spacing:0.06em;\">Focus Timer</div>\n    <div id=\"clock\" style=\"font-size:34px;font-weight:800;font-family:monospace;\">25:00</div>\n  </div>\n  <div style=\"display:flex;gap:8px;\">\n    <button id=\"toggle\" style=\"padding:8px 16px;border-radius:8px;border:1px solid var(--sx-border);background:var(--sx-fg);color:var(--sx-bg);font-weight:700;cursor:pointer;\">Start</button>\n    <button id=\"reset\" style=\"padding:8px 14px;border-radius:8px;border:1px solid var(--sx-border);background:transparent;color:var(--sx-fg);font-weight:600;cursor:pointer;\">Reset</button>\n  </div>\n</div>\n<script>\n(function(){\n  var secs = 25 * 60, timer = null;\n  var clock = document.getElementById('clock');\n  var toggle = document.getElementById('toggle');\n  var reset = document.getElementById('reset');\n  function render() {\n    var m = String(Math.floor(secs / 60)).padStart(2, '0');\n    var s = String(secs % 60).padStart(2, '0');\n    clock.textContent = m + ':' + s;\n  }\n  toggle.addEventListener('click', function() {\n    if (timer) { clearInterval(timer); timer = null; toggle.textContent = 'Start'; return; }\n    toggle.textContent = 'Pause';\n    timer = setInterval(function() {\n      if (secs > 0) { secs--; render(); }\n      else { clearInterval(timer); timer = null; toggle.textContent = 'Done'; }\n    }, 1000);\n  });\n  reset.addEventListener('click', function() {\n    if (timer) { clearInterval(timer); timer = null; }\n    secs = 25 * 60; toggle.textContent = 'Start'; render();\n  });\n  render();\n})();\n</script>",
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#b91c1c\"/><circle cx=\"32\" cy=\"34\" r=\"16\" stroke=\"#ffffff\" stroke-width=\"3.2\"/><path d=\"M26 14H38M32 34V24M32 34L39 38\" stroke=\"#fecaca\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
  "packageUrl": "https://i-am-drunk.github.io/syntax-community/packages/focus-pomodoro-bar.syntaxplugin"
}
