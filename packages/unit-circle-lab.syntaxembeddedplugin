  "sandboxHtml": "<div style=\"display:flex;flex-direction:column;gap:14px;\">\n  <div style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;\">\n    <strong style=\"font-size:15px;\">Interactive Unit Circle Explorer</strong>\n    <span id=\"readout\" style=\"font-family:monospace;font-size:13px;color:var(--sx-muted);\">theta = 45 deg | cos = 0.71 | sin = 0.71</span>\n  </div>\n  <canvas id=\"uc\" width=\"320\" height=\"220\" style=\"width:100%;max-width:340px;align-self:center;border:1px solid var(--sx-border);border-radius:10px;\"></canvas>\n  <label style=\"display:flex;align-items:center;gap:10px;font-size:13px;color:var(--sx-muted);\">\n    <span>Angle:</span>\n    <input id=\"deg\" type=\"range\" min=\"0\" max=\"360\" value=\"45\" style=\"flex:1;\" />\n    <strong id=\"degVal\" style=\"color:var(--sx-fg);min-width:44px;text-align:right;\">45 deg</strong>\n  </label>\n</div>\n<script>\n(function(){\n  var c = document.getElementById('uc');\n  var ctx = c.getContext('2d');\n  var slider = document.getElementById('deg');\n  var degVal = document.getElementById('degVal');\n  var readout = document.getElementById('readout');\n  function draw() {\n    var d = Number(slider.value);\n    var r = d * Math.PI / 180;\n    var cx = 160, cy = 110, rad = 82;\n    var x = cx + Math.cos(r) * rad;\n    var y = cy - Math.sin(r) * rad;\n    ctx.clearRect(0, 0, c.width, c.height);\n    ctx.strokeStyle = '#555';\n    ctx.lineWidth = 1;\n    ctx.beginPath(); ctx.moveTo(20, cy); ctx.lineTo(300, cy); ctx.moveTo(cx, 14); ctx.lineTo(cx, 206); ctx.stroke();\n    ctx.strokeStyle = '#888'; ctx.lineWidth = 2;\n    ctx.beginPath(); ctx.arc(cx, cy, rad, 0, Math.PI * 2); ctx.stroke();\n    ctx.strokeStyle = '#3b82f6'; ctx.lineWidth = 2.5;\n    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, cy); ctx.stroke();\n    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5;\n    ctx.beginPath(); ctx.moveTo(x, cy); ctx.lineTo(x, y); ctx.stroke();\n    ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 2.5;\n    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, y); ctx.stroke();\n    ctx.fillStyle = '#f59e0b';\n    ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.fill();\n    degVal.textContent = d + ' deg';\n    readout.textContent = 'cos(' + d + ') = ' + Math.cos(r).toFixed(2) + ' | sin(' + d + ') = ' + Math.sin(r).toFixed(2);\n  }\n  slider.addEventListener('input', draw);\n  draw();\n})();\n</script>",
